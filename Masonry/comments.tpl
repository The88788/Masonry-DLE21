<article class="comment-item">
<img src="{foto}" alt="{login}">
<div class="content">
<ul class="info list-inline">
<li>{login}</li>
<li class="dot"></li>
<li> {date=d-M-Y, H:i}</li>
</ul>
<div class="full-comment">{comment}</div>
<div class="com_btn">
[fast]<span class="link"> <svg class="ui-icon-svg inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5-6 6 6 6M3 11h10a7 7 0 0 1 7 7"/></svg> Ответить</span>[/fast]
[com-edit]<span class="link"> <svg class="ui-icon-svg inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></svg> Изменить</span>[/com-edit]
[com-del]<span class="link"> <svg class="ui-icon-svg inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg> Удалить</span>[/com-del]
</div>
</div>
</article>