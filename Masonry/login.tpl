[not-group=5]
<button type="button" class="user-icon mr-2 icon-button" data-login-open aria-label="Личный кабинет"><svg class="ui-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></button>
<dialog id="div_modal_dle" class="login-dialog" aria-label="Кабинет - {login}"><button type="button" class="dialog-close icon-button" data-login-close aria-label="Закрыть"><svg class="ui-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
<div class="bg-theme rounded p-3 mb-3 text-center">
<a href="{profile-link}"><img src="{foto}" class="w-25 fs-14 circle mb-2" alt="Аватар пользователя" width="80" height="80"></a>
<div><a href="{profile-link}" class="text-white fs-11">{login}</a></div>
<div class="text-white">{group}</div>
</div>
<div class="row">
[admin-link]<div class="col-md-12"><a href="{admin-link}" class="btn btn-custom mb-3 btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></svg> Админпанель</a></div>[/admin-link]
<div class="col-md-6"><a href="{addnews-link}" class="btn btn-custom mb-3 btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 3 5 5-13 13H3v-5Z"/></svg> Добавить пост</a></div>
<div class="col-md-6"><a href="{profile-link}" class="btn btn-custom mb-3 btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg> Мой профиль</a></div>
<div class="col-md-6"><a href="{pm-link}" class="btn btn-custom mb-3 btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg> Сообщения</a></div>
<div class="col-md-6"><a href="{favorites-link}" class="btn btn-custom mb-3 btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg> Избранное</a></div>
<div class="col-md-6"><a href="{newposts-link}" class="btn btn-custom mb-3 btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5h7l2 2h8v3H7l-4 10h15l4-10H7"/></svg> Непрочитанное</a></div>
<div class="col-md-6"><a href="{THEME}/../../index.php?do=lastcomments" class="btn btn-custom mb-3 btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11a9 9 0 0 1-9 9H3l2-4a9 9 0 1 1 16-5Z"/></svg> Комментарии</a></div>
<div class="col-md-12"><a href="{logout-link}" class="btn btn-custom btn-block"><svg class="ui-icon-svg inline-icon  mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></svg> Выйти</a></div>
</div>
</dialog>
[/not-group]

[group=5]
<button type="button" class="user-icon mr-2 icon-button" data-login-open aria-label="Личный кабинет"><svg class="ui-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></button>
<dialog id="div_modal_dle" class="login-dialog" aria-label="Авторизация"><button type="button" class="dialog-close icon-button" data-login-close aria-label="Закрыть"><svg class="ui-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
<form name="login-form" id="loginform" class="sign-form widget-form" method="post">
<div class="form-group">
<input type="text" class="form-control" placeholder="{login-method}" aria-label="{login-method}" autocomplete="username" required name="login_name">
</div>
<div class="form-group">
<input type="password" class="form-control" placeholder="Пароль" aria-label="Пароль" autocomplete="current-password" required name="login_password">
</div>
<div class="sign-controls form-group">

<a href="{lostpassword-link}" class="btn-link ml-auto">Забыли пароль?</a>
</div>
<div class="form-group"><button type="submit" class="btn-custom">Войти</button></div>
<p class="form-group text-center">Нет аккаунта? <a href="{registration-link}" class="btn-link">Создать прямо сейчас!</a> </p>
[telegram]<p><a href="{telegram_url}">Войти через Telegram</a></p>[/telegram]
<input name="login" type="hidden" id="login" value="submit">
</form>
</dialog>
[/group]