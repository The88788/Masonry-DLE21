<div class="post-card">
<div class="row">
<div class="col-md-4"><div class="post-card-image" style="margin:0 0"><a href="{full-link}" aria-label="{title}">[xfgiven_poster]<img src="[xfvalue_thumb_url_poster]" alt="" loading="lazy" width="800" height="500">[/xfgiven_poster][xfnotgiven_poster]<span class="image-placeholder" aria-hidden="true">M</span>[/xfnotgiven_poster]</a></div></div>
<div class="col-md-8">
<div class="post-card-content">
<div class="categorie">{link-category}</div>
<h2><a href="{full-link}">{title}</a></h2>
<p>{short-story limit="150"}</p>
<div class="post-card-info">
<ul class="list-inline">

<li>[profile]{login}[/profile]</li>
<li class="dot"></li>
<li>{date}</li>
</ul>
</div></div></div></div></div></div>
[/shortresult]
[/searchposts]
[searchcomments]
[fullresult]{include file="comments.tpl"}[/fullresult]
[shortresult]{include file="comments.tpl"}[/shortresult]
[/searchcomments]